# Backend (Fastify + TypeScript con tsx, como Centrolab). Contexto de build = raíz del repo.
FROM node:22-slim
RUN apt-get update && apt-get install -y --no-install-recommends wget && rm -rf /var/lib/apt/lists/* \
    && corepack enable
WORKDIR /app
ENV TZ=America/Argentina/Buenos_Aires NODE_ENV=production

# Manifiestos primero: mientras no cambien, Docker reusa la capa de dependencias.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY backend/package.json backend/
COPY shared/package.json shared/
RUN pnpm install --frozen-lockfile --filter @moldeados/backend... --prod=false

COPY shared shared
COPY backend backend
WORKDIR /app/backend
EXPOSE 4800
# Migraciones al arrancar: si alguna falla, el contenedor no levanta, queda unhealthy y el deploy corta en rojo.
CMD ["sh", "-c", "pnpm migrate:latest && exec pnpm exec tsx src/server.ts"]
