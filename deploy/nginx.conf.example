# Moldeados Córdoba — nginx (mismo VPS que Centrolab y Hassuru). Ejemplo: ajustar dominio y rutas.
# App estática (build de Vite) en /var/www/moldeados; API (Fastify) en 127.0.0.1:4800 bajo /api.
# Misma origen para app y API: sin CORS en producción y el QR/cámara funcionan con el certificado del dominio.

server {
    listen 443 ssl http2;
    server_name sistema.moldeadoscordoba.com.ar;
    # ssl_certificate ...; ssl_certificate_key ...;   (Certbot) — HTTPS obligatorio: sin él el iPhone no da la cámara.

    root /var/www/moldeados;
    index index.html;

    gzip on;
    gzip_comp_level 5;
    gzip_types text/css application/javascript application/json text/csv image/svg+xml application/manifest+json;

    # Archivos con hash en el nombre: no cambian nunca, el navegador los guarda un año.
    location /assets/ { expires 1y; add_header Cache-Control "public, immutable"; try_files $uri =404; }
    location ~* \.(webp|png|webmanifest)$ { expires 7d; try_files $uri =404; }

    # API: fotos de comprobantes de hasta 4 MB (en base64 ~6 MB).
    location /api/ { proxy_pass http://127.0.0.1:4800; client_max_body_size 8m; proxy_set_header X-Forwarded-For $remote_addr; }
    location = /health { proxy_pass http://127.0.0.1:4800; }

    # index.html sin cache: así un deploy se ve al instante. El resto lo resuelve la app (rutas del cliente).
    location / { add_header Cache-Control "no-cache"; try_files $uri /index.html; }
}
