# Copiar a deploy/backend.env EN EL SERVIDOR (no va al repo):  cp backend.env.example backend.env && chmod 600 backend.env
# Misma contraseña que DB_PASS de .env; el host es el contenedor "db".
DATABASE_URL=postgres://moldeados_app:CAMBIAR@db:5432/moldeados
PORT=4800
# El dominio por el que entran (para CORS; con mismo origen casi no se usa).
APP_URL=https://sistema.moldeadoscordoba.com.ar
# openssl rand -hex 32
JWT_SECRET=
# Resumen diario por mail (opcional). Sin esto, el resumen se ve igual en la app y se comparte por WhatsApp.
EMAIL_PROVIDER=log
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Moldeados Córdoba <sistema@moldeadoscordoba.com.ar>
