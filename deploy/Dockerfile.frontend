# App (Vite) → estáticos servidos por nginx. Contexto de build = raíz del repo.
FROM node:22-slim AS build
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY app/package.json app/
COPY shared/package.json shared/
RUN pnpm install --frozen-lockfile --filter @moldeados/app...
COPY shared shared
COPY app app
# Mismo origen: la app le pega a /api del propio dominio (VITE_API_URL vacío).
ENV VITE_API_URL=""
RUN pnpm --filter @moldeados/app build

FROM nginx:1.27-alpine
COPY deploy/nginx-app.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/app/dist /usr/share/nginx/html
